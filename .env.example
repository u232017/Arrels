# Copy to .env and fill with local paths. Never commit .env or any data file.

# Required
# Carpeta de movilidad de Telefónica (subcarpetas YYYY-MM)
MOBILITY_DIR=/path/to/output_limite_legal
# Carpeta de turismo de Telefónica (subcarpetas YYYYMM)
TOURISM_DIR=/path/to/output_limite_legal 2

# Optional
# Alquiler por barri y trimestre (pendiente de integrar)
RENT_FILE=/path/to/rent_per_barri_quarter.csv
# Residentes por barri y mes (pendiente de integrar)
POPULATION_FILE=/path/to/population_per_barri_month.csv
# Inventario de viviendas de uso turístico, 2025T2 (pendiente de integrar)
HUT_FILE=/path/to/hut_inventory.csv
# Migración residencial anual, o "none"
MIGRATION_FILE=none
# Carpeta de la caché Parquet
CACHE_DIR=data/cache
# Memoria máxima de DuckDB
DUCKDB_MEMORY_LIMIT=6GB
# Carpeta temporal de DuckDB (necesita espacio libre en disco)
DUCKDB_TEMP_DIR=data/cache/duckdb_tmp
# Hilos de DuckDB
DUCKDB_THREADS=8
# 1 = ignorar la caché y reconstruir todo desde los CSV
FORCE_REBUILD=0
