.venv/
__pycache__/
.pytest_cache/
*.py[cod]

# Datos locales: conservar sólo los ficheros de ejemplo o README.
data/raw/*
!data/raw/README.md
data/processed/*
!data/processed/README.md

# NDA: raw and row-level data never enter Git
data/
!data/raw/README.md
!data/processed/README.md
*.csv
*.parquet
*.xlsx
.env

# Datos de referencia públicos (festivos) sí se versionan
!pipeline/reference/
!pipeline/reference/*.csv
.DS_Store
*.egg-info/
